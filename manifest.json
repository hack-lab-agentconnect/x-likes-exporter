{
  "manifest_version": 3,
  "name": "X Likes Exporter",
  "version": "1.1.0",
  "description": "Export the people who liked an X (Twitter) post — or your own liked posts — to JSON by auto-scrolling the list.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "clipboardWrite",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_title": "X Likes Exporter",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
